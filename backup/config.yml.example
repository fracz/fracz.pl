backup_root: "gdrive:Backups/MariaDB"
local_tmp: "/tmp/mariadb-backups"
keep_last: 3

dump:
  binary: "mariadb-dump"
  extra_args:
    - "--single-transaction"
    - "--quick"
    - "--routines"
    - "--triggers"
    - "--events"
    - "--hex-blob"

servers:
  - name: "prod-1"
    host: "10.0.0.11"
    port: 3306
    user: "backup_user"
    password: "CHANGE_ME"
    databases:
      - "app_prod"
      - name: "app_logs"
        skip_tables:
          - "request_log"
          - "session_cache"

  - name: "prod-2"
    host: "10.0.0.12"
    port: 3306
    user: "backup_user"
    password: "CHANGE_ME"
    databases:
      - "billing"
      - "invoices"
